{
  "name": "papertrade-x402",
  "version": "0.1.0",
  "description": "Unofficial pay-per-call Papertrade intelligence API for AI agents over the x402 protocol: wallet liquidation risk, liquidation maps, settlement estimates and top-trader stats, paid in USDC on Solana (first) or Base. Includes a typed x402 client.",
  "license": "Apache-2.0",
  "author": "nirholas",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/client.js",
  "module": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/functions",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "npm run build:app && npm run build:docs",
    "dev:site": "npm run build:site && cd site && wrangler pages dev --port 8793",
    "deploy:site": "npm run build:site && cd site && wrangler pages deploy",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:docs": "node scripts/build-docs.mjs",
    "build:app": "esbuild site/app.ts --bundle --format=esm --minify --target=es2022 --sourcemap --outfile=site/public/app.js",
    "gen:examples": "esbuild scripts/gen-examples.ts --bundle --platform=node --format=esm --outfile=test/.gen.tmp.mjs --banner:js=\"import {createRequire} from 'module';const require=createRequire(import.meta.url);\" && node test/.gen.tmp.mjs; rm -f test/.gen.tmp.mjs"
  },
  "keywords": [
    "papertrade",
    "x402",
    "http-402",
    "solana",
    "usdc",
    "hyperliquid",
    "hyperevm",
    "perps",
    "ai-agents",
    "pay-per-call",
    "base",
    "agent-payments",
    "micropayments",
    "api-monetization",
    "defi",
    "typescript",
    "cloudflare-pages",
    "crypto",
    "web3",
    "agentic-commerce",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "x402-bazaar",
    "llms-txt",
    "agent-card",
    "a2a",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/papertrade-x402.git"
  },
  "homepage": "https://papertrade-x402.pages.dev",
  "bugs": {
    "url": "https://github.com/nirholas/papertrade-x402/issues"
  },
  "dependencies": {
    "@solana/kit": "^5.5.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "hono": "^4.13.13",
    "papertrade-sdk": "github:nirholas/papertrade-sdk",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  },
  "mcpName": "io.github.nirholas/papertrade-x402"
}
